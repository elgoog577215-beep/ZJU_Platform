# Server Configuration
PORT=5181
NODE_ENV=production
FRONTEND_URL=https://tuotuzju.com

# Security - CHANGE THESE IN PRODUCTION!
# Generate a secure key: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SECRET_KEY=your-super-secret-jwt-key-change-this-in-production-min-64-chars

# Admin Password - Must be at least 12 characters with mixed case, numbers and symbols
ADMIN_PASSWORD=ChangeMe123!@#

# WeChat Mini Program Login
# AppSecret must stay on the server; never put it in the mini program project or frontend bundle.
WECHAT_MINIAPP_APPID=your-wechat-miniapp-appid
WECHAT_MINIAPP_SECRET=your-wechat-miniapp-appsecret

# Database
DATABASE_FILE=./database.sqlite

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=500
AUTH_RATE_LIMIT_MAX=20

# File Upload
MAX_FILE_SIZE=524288000
UPLOAD_DIR=./uploads

# LLM Configuration (Optional - for WeChat parsing)
LLM_API_KEY=your-llm-api-key
LLM_BASE_URL=https://api-inference.modelscope.cn/v1
LLM_MODEL=ZhipuAI/GLM-5.1

# WeRead/WeWe RSS source for scheduled WeChat MP ingest
# The admin UI stores only feed IDs; do not put WeRead tokens here.
WEWE_RSS_BASE_URL=https://rss.tuotuzju.com

# Event recommendation rollout: legacy | shadow | v2
AI_EVENT_RECOMMENDATION_MODE=shadow
# Stable user/visitor cohort percentage used when mode is v2
AI_EVENT_RECOMMENDATION_ROLLOUT_PERCENT=10

# CORS
# Supports comma-separated origins. In production prefer setting CORS_ALLOWED_ORIGINS explicitly.
CORS_ALLOWED_ORIGINS=https://tuotuzju.com,http://118.31.78.72
# Legacy single/multi-origin compatibility field
CORS_ORIGIN=http://localhost:5173,http://localhost:5180

# Session/Cookie
COOKIE_SECURE=true
COOKIE_HTTP_ONLY=true
COOKIE_SAME_SITE=strict

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/app.log
