page {
  min-height: 100%;
  background: #f8fafc;
  color: #0f172a;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}

button {
  border-radius: 8rpx;
}

.bridge-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 96rpx 40rpx 56rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 28rpx;
}

.bridge-card {
  border: 1rpx solid rgba(15, 23, 42, 0.1);
  background: rgba(255, 255, 255, 0.94);
  padding: 40rpx;
  box-shadow: 0 24rpx 80rpx rgba(15, 23, 42, 0.08);
}

.bridge-kicker {
  color: #0f766e;
  font-size: 22rpx;
  font-weight: 800;
  letter-spacing: 0.18em;
  text-transform: uppercase;
}

.bridge-title {
  margin-top: 18rpx;
  color: #0f172a;
  font-size: 42rpx;
  font-weight: 900;
  line-height: 1.18;
}

.bridge-desc {
  margin-top: 18rpx;
  color: #475569;
  font-size: 28rpx;
  line-height: 1.65;
}

.bridge-actions {
  display: grid;
  gap: 18rpx;
}

.bridge-button {
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 8rpx;
  font-size: 28rpx;
  font-weight: 800;
}

.bridge-button.primary {
  background: #0f172a;
  color: #ffffff;
}

.bridge-button.secondary {
  border: 1rpx solid rgba(15, 23, 42, 0.16);
  background: #ffffff;
  color: #0f172a;
}
