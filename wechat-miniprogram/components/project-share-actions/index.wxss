.project-share-actions {
    display: grid;
    gap: 18rpx;
}

.project-share-button {
    min-height: 88rpx;
    padding: 0;
    border: 0;
    border-radius: 8rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 28rpx;
    font-weight: 800;
    line-height: 1;
}

.project-share-button::after {
    border: 0;
}

.project-share-button.primary {
    background: #0f172a;
    color: #ffffff;
}

.project-share-button.secondary {
    background: #0f766e;
    color: #ffffff;
}

.project-share-button.ghost {
    border: 1rpx solid rgba(15, 23, 42, 0.16);
    background: #ffffff;
    color: #0f172a;
}
