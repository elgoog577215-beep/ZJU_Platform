.project-share-hero {
  padding: 44rpx 40rpx 38rpx;
  border: 1rpx solid rgba(15, 23, 42, 0.1);
  background: #ffffff;
  box-shadow: 0 24rpx 80rpx rgba(15, 23, 42, 0.08);
}

.project-share-kicker {
  color: #0f766e;
  font-size: 22rpx;
  font-weight: 800;
  letter-spacing: 0.12em;
}

.project-share-title {
  margin-top: 20rpx;
  color: #0f172a;
  font-size: 48rpx;
  font-weight: 900;
  line-height: 1.15;
  word-break: break-word;
}

.project-share-desc {
  margin-top: 20rpx;
  color: #475569;
  font-size: 28rpx;
  line-height: 1.65;
  word-break: break-word;
}

.project-share-cover-wrap {
  margin-top: 30rpx;
  overflow: hidden;
  border-radius: 8rpx;
  background: #e2e8f0;
}

.project-share-cover {
  display: block;
  width: 100%;
  height: 278rpx;
}

.project-share-cover.fallback {
  height: 278rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #0f172a 0%, #0f766e 100%);
  color: #ffffff;
  font-size: 88rpx;
  font-weight: 900;
}
