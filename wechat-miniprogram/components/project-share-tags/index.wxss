.project-share-tags-card {
    padding: 28rpx 26rpx;
    border: 1rpx solid rgba(15, 23, 42, 0.1);
    border-radius: 8rpx;
    background: #ffffff;
}

.project-share-tag-section + .project-share-tag-section {
    margin-top: 28rpx;
}

.project-share-tag-title {
    color: #475569;
    font-size: 24rpx;
    font-weight: 900;
}

.project-share-tag-row {
    margin-top: 14rpx;
    display: flex;
    flex-wrap: wrap;
    gap: 12rpx;
}

.project-share-tag {
    padding: 10rpx 16rpx;
    border-radius: 999rpx;
    font-size: 24rpx;
    font-weight: 900;
}

.project-share-tag.need {
    background: #ecfeff;
    color: #155e75;
}

.project-share-tag.tech {
    background: #eef2ff;
    color: #3730a3;
}
