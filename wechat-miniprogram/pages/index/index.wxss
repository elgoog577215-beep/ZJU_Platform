page {
    background: #f8fafc;
}

.native-home-page {
    min-height: 100vh;
    box-sizing: border-box;
    padding: 112rpx 40rpx 56rpx;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 28rpx;
    background: #f8fafc;
}

.native-home-card {
    border: 1rpx solid rgba(15, 23, 42, 0.1);
    border-radius: 8rpx;
    background: #ffffff;
    padding: 44rpx 40rpx;
    box-shadow: 0 24rpx 80rpx rgba(15, 23, 42, 0.08);
}

.native-home-kicker {
    color: #0f766e;
    font-size: 22rpx;
    font-weight: 800;
}

.native-home-title {
    margin-top: 20rpx;
    color: #0f172a;
    font-size: 48rpx;
    font-weight: 900;
    line-height: 1.15;
}

.native-home-desc {
    margin-top: 20rpx;
    color: #475569;
    font-size: 28rpx;
    line-height: 1.65;
}

.native-home-origin {
    margin-top: 28rpx;
    padding: 18rpx 20rpx;
    border-radius: 8rpx;
    background: #ecfeff;
    color: #155e75;
    font-size: 24rpx;
    font-weight: 700;
    word-break: break-all;
}

.native-home-actions {
    display: flex;
    flex-direction: column;
    gap: 18rpx;
}

.webview-status-panel {
    position: fixed;
    left: 40rpx;
    right: 40rpx;
    top: 220rpx;
    z-index: 99999;
    padding: 34rpx 32rpx;
    border: 1rpx solid rgba(15, 23, 42, 0.1);
    border-radius: 8rpx;
    background: #ffffff;
    color: #0f172a;
    box-shadow: 0 24rpx 80rpx rgba(15, 23, 42, 0.12);
}

.webview-status-title {
    color: #0f172a;
    font-size: 34rpx;
    font-weight: 900;
    line-height: 44rpx;
}

.webview-status-desc {
    margin-top: 16rpx;
    color: #475569;
    font-size: 26rpx;
    line-height: 40rpx;
}

.webview-status-url {
    margin-top: 18rpx;
    padding: 16rpx;
    border-radius: 8rpx;
    background: #ecfeff;
    color: #155e75;
    font-size: 22rpx;
    line-height: 32rpx;
    word-break: break-all;
}

.webview-status-actions {
    display: flex;
    gap: 16rpx;
    margin-top: 24rpx;
}

.webview-status-button {
    flex: 1;
    height: 72rpx;
    line-height: 72rpx;
    border-radius: 8rpx;
    background: #f8fafc;
    color: #0f172a;
    font-size: 25rpx;
    font-weight: 800;
    text-align: center;
}

.webview-status-button.primary {
    background: #0f172a;
    color: #ffffff;
}

.project-share-page {
    min-height: 100vh;
    box-sizing: border-box;
    padding: 96rpx 40rpx 56rpx;
    display: flex;
    flex-direction: column;
    gap: 28rpx;
    background: #f8fafc;
    color: #0f172a;
}

.project-share-body {
    display: grid;
    gap: 20rpx;
}

.project-status {
    padding: 20rpx 22rpx;
    border-radius: 8rpx;
    background: #ecfeff;
    color: #155e75;
    font-size: 24rpx;
    font-weight: 800;
}

.project-status.warn {
    background: rgba(248, 113, 113, 0.12);
    color: #991b1b;
}

.local-debug-panel {
    position: fixed;
    left: 16px;
    right: 16px;
    bottom: 24px;
    z-index: 99999;
    padding: 12px;
    border-radius: 10px;
    background: rgba(8, 13, 28, 0.94);
    color: #ffffff;
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.28);
}

.local-debug-title {
    font-size: 13px;
    font-weight: 700;
    line-height: 18px;
}

.local-debug-status {
    margin-top: 4px;
    color: #a7f3d0;
    font-size: 12px;
    line-height: 16px;
}

.local-debug-url {
    margin-top: 6px;
    color: rgba(255, 255, 255, 0.72);
    font-size: 10px;
    line-height: 14px;
    word-break: break-all;
}

.local-debug-actions {
    display: flex;
    gap: 8px;
    margin-top: 10px;
}

.local-debug-button {
    flex: 1;
    height: 32px;
    line-height: 32px;
    border-radius: 7px;
    background: rgba(255, 255, 255, 0.12);
    color: #ffffff;
    font-size: 12px;
    font-weight: 700;
    text-align: center;
}

.local-debug-button.primary {
    background: #4f46e5;
}

.local-debug-button.danger {
    background: rgba(248, 113, 113, 0.22);
    color: #fecaca;
}
