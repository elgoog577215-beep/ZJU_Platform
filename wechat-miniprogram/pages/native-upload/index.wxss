page {
  min-height: 100%;
  background: #080912;
  color: #ffffff;
}

.native-upload-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 150rpx 36rpx 64rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 28rpx;
  background:
    linear-gradient(180deg, rgba(20, 24, 38, 0.96) 0%, rgba(7, 9, 18, 1) 46%, rgba(12, 14, 24, 1) 100%),
    linear-gradient(135deg, rgba(79, 70, 229, 0.14), rgba(147, 51, 234, 0.1));
}

.native-upload-surface {
  position: relative;
  overflow: hidden;
  padding: 58rpx 44rpx 46rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 14rpx;
  background: rgba(10, 10, 16, 0.86);
  box-shadow: 0 34rpx 92rpx rgba(0, 0, 0, 0.42);
}

.native-upload-inline-status {
  min-height: 220rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 18rpx;
  color: rgba(255, 255, 255, 0.82);
  font-size: 28rpx;
  font-weight: 800;
  text-align: center;
}

.native-upload-inline-file {
  max-width: 86vw;
  color: rgba(226, 232, 240, 0.62);
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1.5;
  word-break: break-all;
}

.native-upload-spinner {
  width: 54rpx;
  height: 54rpx;
  border: 6rpx solid rgba(255, 255, 255, 0.16);
  border-top-color: #818cf8;
  border-radius: 999rpx;
  animation: native-upload-spin 720ms linear infinite;
}

@keyframes native-upload-spin {
  to {
    transform: rotate(360deg);
  }
}

.native-upload-accent {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  pointer-events: none;
  background:
    linear-gradient(135deg, rgba(99, 102, 241, 0.18), rgba(147, 51, 234, 0.12) 42%, transparent 72%),
    linear-gradient(180deg, rgba(255, 255, 255, 0.035), transparent);
}

.native-upload-kicker,
.native-upload-title,
.native-upload-desc,
.native-upload-file,
.native-upload-progress,
.native-upload-error {
  position: relative;
  z-index: 1;
}

.native-upload-kicker {
  color: #a5b4fc;
  font-size: 24rpx;
  font-weight: 900;
  letter-spacing: 0.18em;
}

.native-upload-title {
  margin-top: 24rpx;
  color: #ffffff;
  font-size: 52rpx;
  font-weight: 900;
  line-height: 1.12;
}

.native-upload-desc {
  margin-top: 18rpx;
  color: rgba(226, 232, 240, 0.62);
  font-size: 28rpx;
  line-height: 1.7;
}

.native-upload-file {
  margin-top: 30rpx;
  padding: 20rpx 22rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  border-radius: 10rpx;
  background: rgba(255, 255, 255, 0.045);
  color: rgba(255, 255, 255, 0.86);
  font-size: 25rpx;
  line-height: 1.5;
  word-break: break-all;
}

.native-upload-progress {
  margin-top: 24rpx;
  display: grid;
  gap: 12rpx;
  color: rgba(226, 232, 240, 0.72);
  font-size: 24rpx;
}

.native-upload-progress-track {
  overflow: hidden;
  height: 12rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.1);
}

.native-upload-progress-fill {
  height: 100%;
  min-width: 4%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #4f46e5 0%, #9333ea 100%);
  transition: width 160ms ease;
}

.native-upload-error {
  margin-top: 30rpx;
  padding: 22rpx 24rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  border: 1rpx solid rgba(248, 113, 113, 0.22);
  border-radius: 12rpx;
  background: rgba(239, 68, 68, 0.1);
  color: #fecaca;
  font-size: 26rpx;
  line-height: 1.5;
}

.native-upload-error-icon {
  width: 34rpx;
  height: 34rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  border-radius: 999rpx;
  background: #ef4444;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 34rpx;
  text-align: center;
}

.native-upload-actions {
  display: grid;
  gap: 18rpx;
  padding: 0 26rpx;
}

.native-upload-button {
  padding: 0;
  border: 0;
  min-height: 92rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  border-radius: 10rpx;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 1;
}

.native-upload-button::after {
  border: 0;
}

.native-upload-button.primary {
  background: linear-gradient(90deg, #4f46e5 0%, #9333ea 100%);
  color: #ffffff;
  box-shadow: 0 18rpx 44rpx rgba(99, 102, 241, 0.32);
}

.native-upload-button.secondary {
  border: 1rpx solid rgba(255, 255, 255, 0.14);
  background: rgba(255, 255, 255, 0.045);
  color: rgba(255, 255, 255, 0.9);
}

.native-upload-button[disabled] {
  opacity: 0.58;
}
