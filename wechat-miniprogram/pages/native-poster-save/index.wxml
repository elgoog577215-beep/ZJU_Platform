<view class="poster-save-page">
  <view class="poster-save-surface">
    <view class="poster-save-kicker">{{copy.kicker}}</view>
    <view class="poster-save-title">{{copy.title}}</view>
    <view class="poster-save-desc">{{copy.description}}</view>

    <view class="poster-preview">
      <image
        wx:if="{{imageUrl}}"
        class="poster-image"
        src="{{imageUrl}}"
        mode="widthFix"
        show-menu-by-longpress="{{true}}"
      />
      <view wx:else class="poster-empty">{{copy.noImage}}</view>
    </view>

    <view class="poster-status {{status}}">
      {{status === 'saved' ? copy.saved : status === 'downloading' ? copy.downloading : status === 'failed' ? copy.failed : copy.ready}}
    </view>
  </view>

  <view class="poster-save-actions">
    <button
      class="poster-save-button primary"
      loading="{{isSaving}}"
      disabled="{{isSaving || !imageUrl}}"
      bindtap="savePoster"
    >
      {{isSaving ? copy.saving : status === 'failed' ? copy.retry : copy.save}}
    </button>
    <button class="poster-save-button secondary" bindtap="goBack">
      {{copy.back}}
    </button>
  </view>
</view>
