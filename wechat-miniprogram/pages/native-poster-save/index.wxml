<view class="poster-save-page">
  <view class="poster-save-surface">
    <view class="poster-save-kicker">{{pageCopy.kicker}}</view>
    <view class="poster-save-title">{{pageCopy.title}}</view>
    <view class="poster-save-desc">{{pageCopy.description}}</view>

    <view class="poster-preview">
      <image
        wx:if="{{imageUrl}}"
        class="poster-image"
        src="{{imageUrl}}"
        mode="widthFix"
        show-menu-by-longpress="{{true}}"
      />
      <view wx:else class="poster-empty">{{copy.noImage}}</view>
    </view>

    <view class="poster-status {{status}}">
      {{status === 'saved' ? copy.saved : status === 'shared' ? copy.sharePanelOpened : status === 'downloading' ? copy.downloading : status === 'failed' ? pageCopy.failed : pageCopy.ready}}
    </view>
  </view>

  <view class="poster-save-actions">
    <button
      class="poster-save-button primary"
      loading="{{isBusy}}"
      disabled="{{isBusy || !imageUrl}}"
      bindtap="handlePrimaryAction"
    >
      {{isBusy ? pageCopy.busy : status === 'failed' ? pageCopy.retry : pageCopy.primary}}
    </button>
    <button
      wx:if="{{action === 'share'}}"
      class="poster-save-button secondary"
      disabled="{{isBusy || !imageUrl}}"
      bindtap="savePoster"
    >
      {{copy.save}}
    </button>
    <button class="poster-save-button secondary" bindtap="goBack">
      {{copy.back}}
    </button>
  </view>
</view>
