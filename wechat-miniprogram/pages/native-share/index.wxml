<view class="native-share-page">
  <project-share-hero project="{{project}}" copy="{{copy}}" />

  <view class="native-share-body">
    <view wx:if="{{loading}}" class="project-status">{{copy.loading}}</view>
    <view wx:elif="{{failed}}" class="project-status warn">{{copy.failed}}</view>

    <project-share-meta items="{{metaItems}}" />
    <project-share-tags sections="{{tagSections}}" />
  </view>

  <view class="native-share-actions">
    <button class="project-share-button primary" open-type="share">{{copy.shareNow}}</button>
    <button class="project-share-button ghost" bindtap="goBack">{{copy.back}}</button>
  </view>
</view>
