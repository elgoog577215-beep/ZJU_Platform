page {
  background: #f8fafc;
}

.native-share-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 96rpx 40rpx 56rpx;
  display: flex;
  flex-direction: column;
  gap: 28rpx;
  background: #f8fafc;
  color: #0f172a;
}

.native-share-body {
  display: grid;
  gap: 20rpx;
}

.project-status {
  padding: 20rpx 22rpx;
  border-radius: 8rpx;
  background: #ecfeff;
  color: #155e75;
  font-size: 24rpx;
  font-weight: 800;
}

.project-status.warn {
  background: rgba(248, 113, 113, 0.12);
  color: #991b1b;
}

.native-share-actions {
  display: grid;
  gap: 18rpx;
}

.project-share-button {
  min-height: 88rpx;
  padding: 0;
  border: 0;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1;
}

.project-share-button::after {
  border: 0;
}

.project-share-button.primary {
  background: #0f172a;
  color: #ffffff;
}

.project-share-button.ghost {
  border: 1rpx solid rgba(15, 23, 42, 0.16);
  background: #ffffff;
  color: #0f172a;
}
