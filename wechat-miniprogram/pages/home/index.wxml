<view class="home-page">
  <view class="home-card">
    <view class="home-kicker">TUOTUZJU MINI PROGRAM</view>
    <view class="home-title">Tuotu ZJU</view>
    <view class="home-desc">
      Native diagnostic entry. If this page is visible, the mini program shell is compiling and rendering correctly.
    </view>
    <view class="home-origin">{{webOrigin}}</view>
  </view>

  <view class="home-actions">
    <button class="bridge-button primary" bindtap="openEvents">Open Events</button>
    <button class="bridge-button secondary" bindtap="openFallback">Open Diagnostic</button>
  </view>
</view>
