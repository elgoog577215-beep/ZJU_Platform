<view class="login-page">
  <view class="login-surface">
    <view class="login-accent"></view>
    <view class="login-kicker">WECHAT LOGIN</view>
    <view class="login-title">微信账号登录</view>
    <view class="login-desc">
      使用微信身份完成登录后，将自动回到拓途浙享网页，并复用网站的账号与内容权限。
    </view>
    <view wx:if="{{error}}" class="login-error">
      <view class="login-error-icon">!</view>
      <text>{{error}}</text>
    </view>
  </view>

  <view class="login-actions">
    <button
      class="login-button primary"
      loading="{{loading}}"
      disabled="{{loading}}"
      bindtap="handleWechatLogin"
    >
      微信一键登录
    </button>
    <button
      class="login-button secondary"
      disabled="{{loading}}"
      bindtap="openHome"
    >
      返回活动入口
    </button>
  </view>
</view>
