<view class="bridge-page">
  <view class="bridge-card">
    <view class="bridge-kicker">WECHAT LOGIN</view>
    <view class="bridge-title">微信账号登录</view>
    <view class="bridge-desc">
      使用微信身份完成登录后，将自动回到拓途浙享网页，并复用网站的账号与内容权限。
    </view>
    <view wx:if="{{error}}" class="login-error">{{error}}</view>
  </view>

  <view class="bridge-actions">
    <button
      class="bridge-button primary"
      loading="{{loading}}"
      disabled="{{loading}}"
      bindtap="handleWechatLogin"
    >
      微信一键登录
    </button>
    <button
      class="bridge-button secondary"
      disabled="{{loading}}"
      bindtap="openHome"
    >
      返回活动入口
    </button>
  </view>
</view>
