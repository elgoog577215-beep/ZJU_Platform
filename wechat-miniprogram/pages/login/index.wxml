<view class="login-page">
  <view class="login-surface">
    <view class="login-accent"></view>
    <view class="login-kicker">{{copy.kicker}}</view>
    <view class="login-title">{{copy.title}}</view>
    <view class="login-desc">
      {{copy.description}}
    </view>
    <view wx:if="{{error}}" class="login-error">
      <view class="login-error-icon">!</view>
      <text>{{error}}</text>
    </view>
  </view>

  <view class="login-actions">
    <button
      class="login-button primary"
      loading="{{loading}}"
      disabled="{{loading}}"
      bindtap="handleWechatLogin"
    >
      {{copy.primaryButton}}
    </button>
    <button
      class="login-button secondary"
      disabled="{{loading}}"
      bindtap="openHome"
    >
      {{copy.secondaryButton}}
    </button>
  </view>
</view>
