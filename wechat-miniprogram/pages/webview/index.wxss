page {
    background: #ffffff;
}

.local-debug-panel {
    position: fixed;
    left: 16px;
    right: 16px;
    bottom: 24px;
    z-index: 99999;
    padding: 12px;
    border-radius: 10px;
    background: rgba(8, 13, 28, 0.94);
    color: #ffffff;
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.28);
}

.local-debug-title {
    font-size: 13px;
    font-weight: 700;
    line-height: 18px;
}

.local-debug-status {
    margin-top: 4px;
    color: #a7f3d0;
    font-size: 12px;
    line-height: 16px;
}

.local-debug-url {
    margin-top: 6px;
    color: rgba(255, 255, 255, 0.72);
    font-size: 10px;
    line-height: 14px;
    word-break: break-all;
}

.local-debug-actions {
    display: flex;
    gap: 8px;
    margin-top: 10px;
}

.local-debug-button {
    flex: 1;
    height: 32px;
    line-height: 32px;
    border-radius: 7px;
    background: rgba(255, 255, 255, 0.12);
    color: #ffffff;
    font-size: 12px;
    font-weight: 700;
    text-align: center;
}

.local-debug-button.primary {
    background: #4f46e5;
}

.local-debug-button.danger {
    background: rgba(248, 113, 113, 0.22);
    color: #fecaca;
}
